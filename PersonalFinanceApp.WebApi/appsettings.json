{
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_VIA_USER_SECRETS_OR_ENVIRONMENT_VARIABLE"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_NEW_ROTATED_SECRET_AT_LEAST_32_CHARS_VIA_USER_SECRETS",
    "Issuer": "PersonalFinanceApp",
    "Audience": "PersonalFinanceAppClient",
    "ExpiryMinutes": 60
  },
  "Seq": {
    "ServerUrl": "http://localhost:5341"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "PersonalFinanceApp"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
